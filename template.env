APP_ORIGIN=http://localhost:3000
MDPOSIT_BASE_URL=https://example.invalid/api/rest/v1
MDREPO_BASE_URL=https://example.invalid
# Backend of the public records search and detail: mdposit (default) or mdrepo.
RECORDS_SOURCE=mdposit
# Auth.js (next-auth v5). Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=replace-with-32-plus-random-chars
AUTH_URL=http://localhost:3000
# e-INFRA CZ OIDC. Dev with the mock: http://localhost:9090/oidc/
AUTH_OIDC_ISSUER=https://login.e-infra.cz/oidc/
AUTH_OIDC_CLIENT_ID=replace-me
AUTH_OIDC_CLIENT_SECRET=replace-me
AUTH_OIDC_SCOPE=openid profile email organization perun_api offline_access
# AUTH_OIDC_TOKEN_ENDPOINT=
# Absolute session lifetime (8h) and idle timeout (2h).
SESSION_TTL_S=28800
SESSION_IDLE_TTL_S=7200
UPLOAD_MAX_BYTES=52428800
BACKEND_TIMEOUT_MS=15000
LOG_LEVEL=info
MOCK_PORT=9090
MOCK_OIDC_CLIENT_ID=replace-me
MOCK_OIDC_CLIENT_SECRET=replace-me
MOCK_OIDC_ACCESS_TTL_S=900
NEXT_TELEMETRY_DISABLED=1
